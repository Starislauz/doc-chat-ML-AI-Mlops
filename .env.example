# ===========================================
# RAG Document Chat - Environment Variables
# ===========================================

# ---------------------------------------------------------------
# LLM provider for text generation: "deepseek" (recommended) or "gemini"
# ---------------------------------------------------------------
LLM_PROVIDER=deepseek

# DeepSeek - used for document answers when LLM_PROVIDER=deepseek
# Get a key from https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-your-key-here

# Google Gemini - required only when LLM_PROVIDER=gemini.
# Also used to read text out of IMAGES (DeepSeek has no vision), so it is worth
# setting even when DeepSeek writes the answers.
# Get a key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-key-here

# Alternative name for the same Gemini key
GOOGLE_API_KEY=${GEMINI_API_KEY}

# ===========================================
# Application Settings (Optional)
# ===========================================

# Debug mode (true/false)
DEBUG=false

# Secret key for JWT tokens.
# Generate your own before deploying:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-your-own-random-secret

# Token expiration (in minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ===========================================
# Model Configuration (Optional)
# ===========================================

# Gemini model version
GEMINI_MODEL=gemini-2.5-flash

# Embedding model
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ===========================================
# File Upload Settings (Optional)
# ===========================================

# Max file size in bytes (10MB default)
MAX_FILE_SIZE=10485760

# Max files per upload
MAX_FILES_PER_UPLOAD=5

# ===========================================
# CORS Settings (Optional)
# ===========================================

# Allowed origins (comma-separated)
CORS_ORIGINS=*

# ===========================================
# RAG Tuning (Optional - defaults shown)
# ===========================================

CHUNK_SIZE=1200
CHUNK_OVERLAP=150
DEFAULT_TOP_K=5

# Hybrid retrieval: vector search + BM25 keyword search (fused with RRF)
ENABLE_HYBRID_SEARCH=true

# Cosine-similarity floor for the vector-only paths (0..1)
RELEVANCE_THRESHOLD=0.35

# Leave unset for rank-based selection. Cross-encoder scores are NOT
# calibrated, so an absolute cutoff is easy to get wrong.
# RERANK_THRESHOLD=

# Semantic answer cache (same user, unchanged documents, similarity >= threshold)
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_THRESHOLD=0.95
