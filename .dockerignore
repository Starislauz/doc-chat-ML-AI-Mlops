# ===========================================
# Docker Ignore File - Optimized Build
# ===========================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/
*.egg

# Virtual environments
venv/
env/
ENV/
.venv

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Git
.git/
.gitignore
.gitattributes

# Docker files (don't include in image)
Dockerfile*
docker-compose*.yml
.dockerignore

# Documentation (will be available in repo)
*.md
README*.md
QUICK_START*.md
HOW_TO*.md

# Old batch files
CLEANUP_USER_DATA.bat
DOCKER_BUILD.bat
DOCKER_CLEAN.bat
DOCKER_COMMANDS.md
DOCKER_LOGS.bat
DOCKER_README.md
DOCKER_START.bat
DOCKER_STATUS.bat
DOCKER_STOP.bat
LAUNCH_UI.bat
START_SERVER.bat

# New batch files (for host use only)
docker-*.bat

# Environment files (use .env at runtime)
.env
.env.local
.env.*.local
.env.example

# User data (will be in volumes)
uploads/
images/
backend/chroma_db/
backend/*.db
backend/**/*.db
backend/uploads/*
backend/images/*
backend/backend/chroma_db/*

# Logs
*.log
logs/

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
test_*.py
*_test.py

# Temporary files
*.tmp
temp/
tmp/

# Backups
backups/
*.tar.gz

# Node modules (if any)
node_modules/

# Makefilefor Linux/Mac only)
Makefile
